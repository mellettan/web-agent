# Игнорирование переменных окружения
# Файл .env содержит секретные данные и не должен быть в репозитории.
.env

# Игнорирование папок с логами и данными пользователя
logs/
user_data/

# Стандартные исключения для Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Папки виртуального окружения
venv/
.venv/
env/
.env/

# Игнорирование файлов IDE (PyCharm)
.idea/

# Игнорирование системных файлов (macOS, Windows)
.DS_Store
Thumbs.db